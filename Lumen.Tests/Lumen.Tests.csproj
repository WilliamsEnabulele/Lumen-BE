<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Only to build fixture PDFs: the tests need real files, and a checked-in binary is a
         fixture nobody can read the diff of. -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumen.Domain\Lumen.Domain.csproj" />
    <ProjectReference Include="..\Lumen.Infrastructure\Lumen.Infrastructure.csproj" />
  </ItemGroup>

</Project>
